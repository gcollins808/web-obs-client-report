# Names only. Copy to .env (git-ignored) and fill in; never commit a real value. Real environment variables win over the file.
# Two groups of settings live here:
#   1. Agency side (the Studio build, the export and publish commands): read from a .env in the repository root.
#   2. Report server (apps/server): read from apps/server/.env, or the file named by ENV_FILE. An empty value means "use the default"
#      (or, for the first three, "not set up yet": the server says so when it starts).
# Only the WEBOBS_FEEDBACK_* values are baked into the Studio at build time, so keep only non-secret values for those.

# ======================= 1. Agency side =======================
# Read by the CLI (npm run report:export-json) and baked into the studio at build time (npm run build),
# so keep only non-secret values here.

# Where the client's feedback email goes (the last step of the guided tour).
# A per-report address set in the studio's Brand tab, or --feedback-to on the CLI, overrides it.
# On the report server this is the team's address (use an address of your own while testing).
WEBOBS_FEEDBACK_TO=

# Optional. {client} becomes the client's name. (Server: subject line of the feedback email; empty means "Feedback from {client} on their website review".)
WEBOBS_FEEDBACK_SUBJECT=

# Read by "npm run publish:client" and the Studio's publish helper only; never built into the page. Where a report and its link entry are copied: user@host:/srv/webobs (over ssh with your own keys) or a local folder.
# Or an https ingest address (https://audit.example.com/ingest/v1/reports): the server makes the link and sends it back. Then also set the three secrets below in your own environment (the OS or your shell), not in a file that is shared.
WEBOBS_PUBLISH_TARGET=
# For the https ingest address only. Names here; real values live in your environment, never in git.
WEBOBS_INGEST_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# The public address the links start with, for example https://reports.example.com
# (Server: the public address of the report app, for the links the tools print, for example https://audit.example.com. No trailing slash.)
WEBOBS_REPORT_BASE=
# The vault whose sites/<domain> captures the Studio can list and archive (helper only; never built into the page).
WEBOBS_VAULT=

# How long a published report link works, in hours (the operator can pick another time when publishing). Helper and command only. Empty: 72.
WEBOBS_REPORT_TTL_HOURS=
# Where the local index of published links (client names, never uploaded) is kept. Empty: .report-index/index.json in this folder.
WEBOBS_REPORT_INDEX=

# ======================= 2. Report server (apps/server) =======================
# A Resend API key made just for this app. Empty: feedback is written to the outbox file instead of emailed. Set it at go-live as a secret on the container host, not in the image.
RESEND_API_KEY=
# The sender for those emails, an address you have set up and verified in Resend. There is no default.
RESEND_FROM=

# "outbox" or "resend". Empty: resend when a key is set, otherwise outbox.
MAIL_MODE=
# Folder for outbox files when no key is set. Empty: /data/outbox.
OUTBOX_DIR=


# Where reports are read from: "directory" (a folder) or "https" (a fixed web address). Empty: directory.
REPORT_SOURCE=
# For "directory": the folder holding the client reports (mount it read-only). Empty: /data/reports.
REPORTS_DIR=
# For "https": the fixed address that serves <report id>.json (must start with https://). The server never takes an address from a request.
REPORT_SOURCE_URL=
# For "https": an optional bearer token the source expects. A secret: set it on the container host, not in the image.
REPORT_SOURCE_TOKEN=
# For "https": how long to wait for the source, in milliseconds. Empty: 5000.
REPORT_SOURCE_TIMEOUT_MS=
# Milliseconds after which every refusal is sent (the same moment for all of them), and at which the read of a remote report source is
# cut off. For a REPORT_SOURCE=https source set it above the source's normal answer time, for example 1500. Empty: 250.
DENIED_DELAY_MS=
# Folder of link entries, one small file of hashes per link (mount it read-only). Empty: /data/registry.
REGISTRY_DIR=
# The built viewer page (dist-report/report.html). Empty: apps/server/app/report.html.
APP_FILE=
# The folder of fonts bundled with the server (Oswald and Inter woff2 files). A report's look can only NAME one of them. Empty: the fonts folder beside server.mjs.
FONTS_DIR=

# Port to listen on. Empty: 8080.
PORT=
# 1 only when the server can be reached ONLY through your HTTPS proxy (the Cloudflare tunnel or your own reverse proxy). It then reads
# X-Forwarded-Proto (the proxy must set it to https) and the client-IP header below. Not baked into the image. Empty: 0.
TRUST_PROXY=
# With TRUST_PROXY=1: the one header that names the caller for the rate limits. Its LAST comma-separated entry is used, and only if it is a
# plain IPv4/IPv6 address; otherwise the connection address (all callers then share one bucket: stricter, never looser).
# Empty: CF-Connecting-IP (set by the Cloudflare tunnel). Without Cloudflare: the header YOUR reverse proxy sets and overwrites, e.g. X-Real-IP.
CLIENT_IP_HEADER=
# 0 to allow plain http (testing only). Empty: HTTPS is required.
REQUIRE_HTTPS=
# Days a report is served before it is treated as gone. Empty: 90.
RETENTION_DAYS=

# Requests per minute from one address. Empty: 60.
RATE_GENERAL_PER_MIN=
# Wrong-token attempts per minute from one address before it is slowed down. Empty: 10.
RATE_BAD_TOKEN_PER_MIN=
# Feedback messages per link per 10 minutes. Empty: 5.
RATE_FEEDBACK_PER_10MIN=

# Use a different settings file than apps/server/.env. Empty: the default file.
ENV_FILE=

# ---- HTTPS ingest (optional; off unless INGEST_ENABLED is 1). See apps/server/ingest/ and docs/INGEST-SECURITY.md ----
# 1 to turn the ingest route on. Empty: off, and the ingest process will not start.
INGEST_ENABLED=
# The application secret the ingest route checks (at least 32 characters; 48 without Cloudflare Access). A secret: set it on the container host and on the laptop as WEBOBS_INGEST_SECRET.
INGEST_SECRET=
# Port of the ingest process (internal only; the tunnel routes the path ingest/* of the viewer's hostname to it). Empty: 8081.
INGEST_PORT=
# The Cloudflare Access check: the ingest verifies the Access token Cloudflare adds (signature, issuer, audience, expiry). Empty or 1: ON
# (the default and the recommended setup). Exactly 0 runs the ingest WITHOUT Cloudflare Access (not recommended, docs/SETUP.md): it then
# also needs INGEST_ACKNOWLEDGE_NO_EDGE_AUTH=yes and an INGEST_SECRET of at least 48 characters, or it refuses to start.
INGEST_REQUIRE_ACCESS_HEADER=
# Must be exactly yes, and only when you deliberately run the ingest without Cloudflare Access (INGEST_REQUIRE_ACCESS_HEADER=0). Empty otherwise.
INGEST_ACKNOWLEDGE_NO_EDGE_AUTH=
# Needed while the Access check is on (INGEST_REQUIRE_ACCESS_HEADER empty or 1): your Zero Trust team domain and the Access application's AUD tag. The server verifies the
# Cloudflare Access token against them. Names only here; the values go in the host's environment.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# The folders ingest writes to (read-write mounts for this process only; the viewer mounts the same folders read-only). Empty: /data/reports and /data/registry.
INGEST_REPORTS_DIR=
INGEST_REGISTRY_DIR=
# Where the audit log goes (ids and times only). Empty: /data/audit/ingest.log.
INGEST_AUDIT_LOG=
# The audit log rotates by size: at this many bytes the file becomes ingest.log.1 (older ones shift up). Empty: 1048576.
INGEST_AUDIT_MAX_BYTES=
# How many old audit files stay in the same folder. Empty: 3. (At most 20.)
INGEST_AUDIT_KEEP=
# Hours a new link lives when the caller does not say: 72. The most a caller may ask for: 720.
INGEST_DEFAULT_HOURS=
INGEST_MAX_HOURS=
# Largest upload in bytes (empty: 2097152), most reports held (empty: 1000), uploads per hour per address (empty: 30), wrong secrets per minute per address (empty: 10).
INGEST_MAX_BYTES=
INGEST_MAX_REPORTS=
INGEST_RATE_PER_HOUR=
INGEST_BAD_PER_MIN=

# Variables for deploy/docker-compose.yml. Copy to deploy/.env (git-ignored) and fill in the values there, never here.
# Names only in this file. Portainer users set the same names in the stack's "Environment variables" box instead.

# The image to run. Default: ghcr.io/OWNER/web-obs-client-report:v0.1.7 (replace OWNER, or point at your own registry).
WEBOBS_IMAGE=
# The Docker network your cloudflared container is on (docker network ls). Default: tunnel.
TUNNEL_NETWORK=
# Which optional services start: empty = viewer only; "ingest", "cleanup" or "ingest,cleanup".
COMPOSE_PROFILES=

# REQUIRED. Public address of the viewer, https, no trailing slash, e.g. https://audit.example.com
WEBOBS_REPORT_BASE=
# Days a report is served at most. Default 90.
RETENTION_DAYS=
# outbox (feedback kept in memory, lost on restart) or resend (emailed). Default outbox.
MAIL_MODE=
# Address that receives client feedback. Optional.
WEBOBS_FEEDBACK_TO=
# SECRET. Resend API key, only with MAIL_MODE=resend.
RESEND_API_KEY=
# Sender address for the feedback email, only with MAIL_MODE=resend.
RESEND_FROM=

# 1 turns the ingest on (it also needs the "ingest" profile above). Anything else: it idles and answers 503 (shown as unhealthy on purpose).
INGEST_ENABLED=
# SECRET. 32+ characters (48+ without Cloudflare Access), e.g. from: openssl rand -hex 32. The plugin's Publish secret holds the same value.
INGEST_SECRET=
# Zero Trust team domain, e.g. yourteam.cloudflareaccess.com (needed when the ingest is on).
CF_ACCESS_TEAM_DOMAIN=
# The Access application's "Application Audience (AUD) Tag" (needed when the ingest is on).
CF_ACCESS_AUD=

# Cloudflare Access check. Empty or 1 (the default): the ingest verifies the Cloudflare Access token. Keep it.
# 0 runs the ingest WITHOUT Cloudflare Access: NOT recommended (docs/SETUP.md, "Running the ingest without Cloudflare").
INGEST_REQUIRE_ACCESS_HEADER=
# Must be 'yes' only when you deliberately run without Cloudflare Access (INGEST_REQUIRE_ACCESS_HEADER=0). Leave empty otherwise.
INGEST_ACKNOWLEDGE_NO_EDGE_AUTH=
# The header that names the caller for the rate limits (viewer and ingest). Empty: CF-Connecting-IP (set by the Cloudflare tunnel).
# Without Cloudflare: the header YOUR reverse proxy sets and overwrites, e.g. X-Real-IP. Its last entry is used, plain IPs only.
CLIENT_IP_HEADER=
